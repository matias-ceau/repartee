#!/bin/sh
# Repartee pre-commit hook: blocks commits that contain chat exports, home data,
# credential files (.env, .pypirc) or API keys. See src/repartee/guard.py.
#
# Install from the repository root:
#   ln -s ../../scripts/pre-commit .git/hooks/pre-commit
#
# Python used, first found: $REPARTEE_PYTHON, the repository's .venv, python3.
# If the guard cannot run, the commit is blocked (it fails closed).

top=$(git rev-parse --show-toplevel) || exit 2

if [ -n "$REPARTEE_PYTHON" ]; then
    py=$REPARTEE_PYTHON
elif [ -x "$top/.venv/bin/python" ]; then
    py=$top/.venv/bin/python
else
    py=python3
fi

if [ -f "$top/src/repartee/guard.py" ]; then
    PYTHONPATH="$top/src${PYTHONPATH:+:$PYTHONPATH}"
    export PYTHONPATH
fi

exec "$py" -m repartee.guard --staged
